---
import Layout from '../layouts/Layout.astro'
import archive from '../../data/episodes.json'
import { artwork, episodeLabel, newestFirst } from '../lib/episodes.js'
import { browseTags, rankTags } from '../lib/tags.js'

const episodes = newestFirst(archive)
const latest = episodes[0]
const popularTags = browseTags(episodes)
const tags = rankTags(episodes).sort((a, b) => a.localeCompare(b, 'en'))
---

<Layout>
  <a class="skip" href="#recordings">Skip to mixes</a>
  <header class="contact-masthead">
    {latest && (
      <picture class="masthead-art" data-episode={latest.slug} aria-hidden="true">
        <img src={artwork(latest.pictures)} alt="" fetchpriority="high" />
      </picture>
    )}
    <div class="contact-name">
      <h1 class="wordmark"><a href="/" data-tag="" aria-label="Epoch's Fables home">Epoch's <span>Fables.</span></a></h1>
      <p class="contact-credit">
        by <a href="https://www.mixcloud.com/kingstonpork/" target="_blank" rel="noopener noreferrer">kingstonpork ↗</a>
        <span>2010 — {new Date().getFullYear()}</span>
      </p>
    </div>
  </header>

  <div class="site">
    <nav class="tag-navigation" aria-label="Browse episode tags">
      <div class="tag-body">
        <div class="tag-topline">
          <h2 id="tag-heading">Popular tags</h2>
          <span class="tag-reset" hidden><a data-tag="" href="/">Reset to popular</a></span>
        </div>
        <div class="tag-scroll" tabindex="0" role="region" aria-label="The 25 most used tags in alphabetical order">
          <ul class="tag-list">
            {tags.map((tag) => (
              <li hidden={!popularTags.includes(tag)}>
                <a class="tag-link" data-tag={tag} href={`?tag=${encodeURIComponent(tag)}`}>{tag}</a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </nav>

    <main id="recordings">
      <header class="results-bar">
        <div class="results-title">
          <h2 tabindex="-1" id="results-heading">All mixes</h2>
          <span class="result-count" aria-live="polite" aria-atomic="true">{episodes.length} mixes</span>
        </div>
        <span class="sort-label">Newest first ↓</span>
      </header>
      <p class="touch-hint">Tap a sleeve for its title and tags.</p>
      <ul class="episode-grid">
        {episodes.map((ep, index) => {
          const label = episodeLabel(ep.name)
          return (
            <li class="episode" id={ep.slug} data-tags={JSON.stringify(ep.tags)} data-key={ep.key} data-slug={ep.slug} data-name={ep.name}>
              <article class="cover-tile" aria-label={ep.name}>
                <a class="cover-listen" data-play href={ep.url} target="_blank" rel="noopener noreferrer" aria-label={`Play ${ep.name}`} aria-description={ep.tags.join(', ')}>
                  <span class="photo-resolve">
                    <img class="cover-image" src={artwork(ep.pictures)} alt={`Original cover artwork for ${ep.name}`} loading={index < 6 ? 'eager' : 'lazy'} width="640" height="640" crossorigin="anonymous" />
                  </span>
                  <span class:list={['cover-label', { 'cover-label--title': label === ep.name.trim() }]} aria-hidden="true">{label}</span>
                </a>
                <button class="touch-cover" type="button" aria-label={`Show details for ${ep.name}`} aria-expanded="false" aria-controls={`info-${ep.slug}`}></button>
                <div class="cover-info" id={`info-${ep.slug}`}>
                  <h3><a class="cover-title" data-play href={ep.url} target="_blank" rel="noopener noreferrer">{ep.name}</a></h3>
                  {ep.tags.length > 0 && (
                    <ul class="cover-tags">
                      {ep.tags.map((tag) => (
                        <li><a class="cover-tag" data-tag={tag} href={`?tag=${encodeURIComponent(tag)}`}>{tag}</a></li>
                      ))}
                    </ul>
                  )}
                  <button class="close-details" type="button">Close details</button>
                </div>
              </article>
            </li>
          )
        })}
      </ul>
      <section class="empty-results" hidden={episodes.length > 0}>
        <h3>No mixes in this view.</h3>
        <a data-tag="" href="/">Return to all mixes</a>
      </section>

      <footer class="archive-footer">
        <a class="source-link" href="https://github.com/simenbrekken/epochsfables.com" target="_blank" rel="noopener noreferrer">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
          </svg>
          View source on GitHub
        </a>
        <a href="https://www.mixcloud.com/kingstonpork/" target="_blank" rel="noopener noreferrer">Listen on Mixcloud ↗</a>
      </footer>
    </main>
  </div>

  <aside id="player" class="player" aria-label="Mixcloud player" hidden>
    <div class="player-inner">
      <button type="button" id="player-close" class="player-close" aria-label="Close player">&times;</button>
      <iframe id="player-iframe" title="Mixcloud episode player" width="100%" height="120" frameborder="0" allow="autoplay" loading="lazy"></iframe>
      <p id="player-error" role="alert" hidden>Playback could not load. <a id="player-external" href="https://www.mixcloud.com/kingstonpork/" target="_blank" rel="noopener noreferrer">Listen on Mixcloud</a></p>
    </div>
  </aside>
</Layout>

<script>
  import '../scripts/archive'
</script>
